# Host port the app is published on (mapped to 8080 inside the container).
APP_PORT=8080

# Public origin used when generating shareable session links.
# Leave blank to derive it from the incoming request.
PUBLIC_ORIGIN=

# Directory (inside the container) holding Guitar Pro files you have added.
# docker-compose mounts ./data/library here.
LIBRARY_DIR=/app/data/library

# Max upload size for Guitar Pro files, in megabytes.
MAX_UPLOAD_MB=25
